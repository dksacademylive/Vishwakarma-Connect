rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@vishwakarma.org' ||
        request.auth.token.email == 'dksacademy.live@gmail.com'
      );
    }

    // Community Posts
    match /posts/{postId} {
      allow read, write: if true;
    }

    // Applications for Jobs, Scholarships & Workshops
    match /applications/{applicationId} {
      allow read, write: if true;
    }

    // Artisan Directory
    match /artisans/{artisanId} {
      allow read, write: if true;
    }

    // Matrimony Profiles
    match /matrimony/{profileId} {
      allow read, write: if true;
    }

    // Site Configuration (Live sync across all devices & public links)
    match /site_config/{configDocId} {
      allow read, write: if true;
    }

    // Community Events
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Amar Shilpi / Luminaries
    match /luminaries/{luminaryId} {
      allow read, write: if true;
    }

    // Samaj Membership Registrations (1 email = 1 membership)
    match /memberships/{membershipId} {
      allow read, write: if true;
    }

    // Temples & Dharamshala In-listing
    match /temples/{templeId} {
      allow read, write: if true;
    }

    // Event Registrations & Passes
    match /event_registrations/{regId} {
      allow read, write: if true;
    }

    // Temple Dharamshala Bookings
    match /temple_bookings/{bookingId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
